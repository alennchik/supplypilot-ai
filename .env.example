# Copy this file to .env (ignored by git) and fill in one key to turn on the
# planning assistant. The rest of the app works without it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: anthropic or openai. Default: the provider whose key is set.
SUPPLYPILOT_AGENT_PROVIDER=

# Optional: model name. Defaults: claude-sonnet-5-5 (Anthropic), gpt-5-mini (OpenAI).
SUPPLYPILOT_AGENT_MODEL=
